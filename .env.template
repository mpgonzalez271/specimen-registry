# SAR — Environment Template
#
# Copy to .env and fill in real values. NEVER commit .env.
# All secrets should be stored in Cloudflare Worker secrets for production.
#
# Usage:
#   cp .env.template .env
#   $EDITOR .env
#

# ============================================================
# Database — Neon Postgres
# ============================================================
# Full connection string with sslmode=require.
# Format: postgresql://<user>:<pass>@<host>/<db>?sslmode=require
#
# In production, the Worker reads this from a Cloudflare Worker secret
# (see docs/CLOUDFLARE_WORKER.md), not from this file.
#
# For local ingest scripts, this is where the CLI reads the connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/specimen_registry?sslmode=require

# Optional read-replica connection string for browse-only queries.
# Leave unset if using a single Neon endpoint.
DATABASE_URL_READONLY=

# ============================================================
# Cloudflare
# ============================================================
# Only needed for local wrangler dev / CI deploy.
# Do NOT put production tokens here — use `wrangler secret put` for the Worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ============================================================
# Ingest scripts
# ============================================================
# GitHub PAT for pushing ingest records to the registry repo.
# Scope: repo:contents write on mpgonzalez271/specimen-registry only.
GITHUB_TOKEN=

# Contact email surfaced on the "About" page and in User-Agent for
# Crossref / Europe PMC requests.
CONTACT_EMAIL=

# ============================================================
# Optional — telemetry
# ============================================================
# Sentry DSN for Worker error tracking (v0.2, not v0).
SENTRY_DSN=
